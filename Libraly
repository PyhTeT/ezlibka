-- opts = {Title, Icon, Position=UDim2, Size=UDim2}
function Library:CreateWindow(opts)
	opts = opts or {}
	local colors = currentColors()

	local Window = {}
	Window.Elements = {}
	Window._colorObjs = {}

	local Frame = new("Frame", {
		Name = "SectionWindow",
		Size = opts.Size or UDim2.fromOffset(260, 320),
		Position = opts.Position or UDim2.fromOffset(40, 40),
		BackgroundColor3 = colors.Background,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = ScreenGui,
	}, {
		new("UICorner", { CornerRadius = UDim.new(0, 8) }),
		new("UIStroke", { Color = colors.Stroke, Thickness = 1 }),
	})

	local TopBar = new("Frame", {
		Name = "TopBar",
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundColor3 = colors.Secondary,
		BorderSizePixel = 0,
		Parent = Frame,
	}, {
		new("UICorner", { CornerRadius = UDim.new(0, 8) }),
	})
	-- маска, чтобы низ topbar был прямым, а не скруглённым
	new("Frame", {
		Size = UDim2.new(1, 0, 0, 10),
		Position = UDim2.new(0, 0, 1, -10),
		BackgroundColor3 = colors.Secondary,
		BorderSizePixel = 0,
		ZIndex = 0,
		Parent = TopBar,
	})

	local IconImg
	if getIcon(opts.Icon) then
		IconImg = new("ImageLabel", {
			Size = UDim2.fromOffset(16, 16),
			Position = UDim2.fromOffset(10, 9),
			BackgroundTransparency = 1,
			Image = getIcon(opts.Icon),
			ImageColor3 = colors.Text,
			Parent = TopBar,
		})
	end

	local Title = new("TextLabel", {
		Name = "Title",
		Size = UDim2.new(1, -70, 1, 0),
		Position = UDim2.fromOffset(IconImg and 32 or 12, 0),
		BackgroundTransparency = 1,
		Text = opts.Title or "Section",
		TextColor3 = colors.Text,
		Font = Enum.Font.GothamMedium,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = TopBar,
	})

	local CollapseBtn = new("TextButton", {
		Size = UDim2.fromOffset(22, 22),
		Position = UDim2.new(1, -28, 0, 6),
		BackgroundColor3 = colors.Toggle_Off,
		Text = "-",
		TextColor3 = colors.Text,
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		AutoButtonColor = true,
		Parent = TopBar,
	}, { new("UICorner", { CornerRadius = UDim.new(0, 5) }) })

	makeDraggable(TopBar, Frame)

	local Body = new("ScrollingFrame", {
		Name = "Body",
		Size = UDim2.new(1, -12, 1, -44),
		Position = UDim2.fromOffset(6, 40),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = colors.Accent,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = Frame,
	}, {
		new("UIListLayout", {
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	local collapsed = false
	local expandedSize = Frame.Size
	CollapseBtn.MouseButton1Click:Connect(function()
		collapsed = not collapsed
		if collapsed then
			expandedSize = Frame.Size
			tween(Frame, { Size = UDim2.new(expandedSize.X.Scale, expandedSize.X.Offset, 0, 34) }, 0.18)
			CollapseBtn.Text = "+"
		else
			tween(Frame, { Size = expandedSize }, 0.18)
			CollapseBtn.Text = "-"
		end
	end)

	-- регистрируем цвета для смены темы
	table.insert(Window._colorObjs, function(c)
		Frame.BackgroundColor3 = c.Background
		TopBar.BackgroundColor3 = c.Secondary
		Title.TextColor3 = c.Text
		if IconImg then IconImg.ImageColor3 = c.Text end
		CollapseBtn.BackgroundColor3 = c.Toggle_Off
		CollapseBtn.TextColor3 = c.Text
		Body.ScrollBarImageColor3 = c.Accent
		for _, stroke in ipairs(Frame:GetChildren()) do
			if stroke:IsA("UIStroke") then stroke.Color = c.Stroke end
		end
	end)
	table.insert(Library._onThemeChanged, table.remove(Window._colorObjs))
	-- (переустановим правильно ниже через общий враппер)

	-- === Элементы ===

	local function rowBase(height)
		return new("Frame", {
			Size = UDim2.new(1, 0, 0, height or 30),
			BackgroundTransparency = 1,
			Parent = Body,
		})
	end

	-- --- Toggle ---
	-- opts: {Text, Default=false, Flag, Callback=function(bool) end}
	function Window:AddToggle(o)
		o = o or {}
		local flag = o.Flag or o.Text
		local state = o.Default or false
		Library.Flags[flag] = state

		local row = rowBase(30)
		local label = new("TextLabel", {
			Size = UDim2.new(1, -46, 1, 0),
			Position = UDim2.fromOffset(4, 0),
			BackgroundTransparency = 1,
			Text = o.Text or "Toggle",
			TextColor3 = currentColors().Text,
			Font = Enum.Font.Gotham,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		})
		local switch = new("TextButton", {
			Size = UDim2.fromOffset(36, 18),
			Position = UDim2.new(1, -40, 0.5, -9),
			BackgroundColor3 = state and currentColors().Accent or currentColors().Toggle_Off,
			Text = "",
			AutoButtonColor = false,
			Parent = row,
		}, { new("UICorner", { CornerRadius = UDim.new(1, 0) }) })
		local knob = new("Frame", {
			Size = UDim2.fromOffset(14, 14),
			Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7),
			BackgroundColor3 = Color3.fromRGB(255, 255, 255),
			Parent = switch,
		}, { new("UICorner", { CornerRadius = UDim.new(1, 0) }) })

		local function set(v, fire)
			state = v
			Library.Flags[flag] = v
			tween(switch, { BackgroundColor3 = v and currentColors().Accent or currentColors().Toggle_Off }, 0.15)
			tween(knob, { Position = v and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7) }, 0.15)
			if fire ~= false and o.Callback then
				task.spawn(o.Callback, v)
			end
		end

		switch.MouseButton1Click:Connect(function() set(not state) end)

		if o.Default then task.spawn(function() if o.Callback then o.Callback(true) end end) end

		table.insert(Window._colorObjs, function(c)
			label.TextColor3 = c.Text
			if not state then switch.BackgroundColor3 = c.Toggle_Off else switch.BackgroundColor3 = c.Accent end
		end)

		local elementApi = {
			Set = function(_, v) set(v, true) end,
			Get = function() return state end,
		}
		Window.Elements[flag] = elementApi

		-- === поддержка бинда для этого тоггла (как в Delta: Toggle + Keybind) ===
		if o.Bindable ~= false then
			local bindKeyLabel = new("TextButton", {
				Size = UDim2.fromOffset(30, 18),
				Position = UDim2.new(1, -78, 0.5, -9),
				BackgroundColor3 = currentColors().Toggle_Off,
				Text = o.DefaultKey and o.DefaultKey.Name or "...",
				TextColor3 = currentColors().SubText,
				Font = Enum.Font.Gotham,
				TextSize = 11,
				Parent = row,
			}, { new("UICorner", { CornerRadius = UDim.new(0, 4) }) })

			local boundKey = o.DefaultKey
			local listening = false

			bindKeyLabel.MouseButton1Click:Connect(function()
				listening = true
				bindKeyLabel.Text = "..."
			end)

			Library.Binds[flag] = {
				Name = o.Text,
				Key = boundKey,
				GetKey = function() return boundKey end,
			}

			UserInputService.InputBegan:Connect(function(input, gpe)
				if listening and not gpe then
					if input.UserInputType == Enum.UserInputType.Keyboard
						or input.UserInputType == Enum.UserInputType.MouseButton1
						or input.UserInputType == Enum.UserInputType.MouseButton2 then
						boundKey = input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode or nil
						local display = inputTypeToString(input) or "?"
						bindKeyLabel.Text = display
						Library.Binds[flag].Key = boundKey
						Library.Binds[flag].Display = display
						listening = false
					end
				elseif not gpe and boundKey and input.KeyCode == boundKey then
					set(not state)
				end
			end)

			table.insert(Window._colorObjs, function(c)
				bindKeyLabel.BackgroundColor3 = c.Toggle_Off
				bindKeyLabel.TextColor3 = c.SubText
			end)
		end

		return elementApi
	end

	-- --- Slider ---
	-- opts: {Text, Min, Max, Default, Rounding, Flag, Callback=function(number) end}
	function Window:AddSlider(o)
		o = o or {}
		local flag = o.Flag or o.Text
		local min, max = o.Min or 0, o.Max or 100
		local rounding = o.Rounding or 0
		local value = o.Default or min
		Library.Flags[flag] = value

		local row = rowBase(38)
		local label = new("TextLabel", {
			Size = UDim2.new(1, -8, 0, 16),
			Position = UDim2.fromOffset(4, 0),
			BackgroundTransparency = 1,
			Text = (o.Text or "Slider") .. ": " .. tostring(value),
			TextColor3 = currentColors().Text,
			Font = Enum.Font.Gotham,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		})
		local track = new("Frame", {
			Size = UDim2.new(1, -8, 0, 6),
			Position = UDim2.fromOffset(4, 22),
			BackgroundColor3 = currentColors().Toggle_Off,
			Parent = row,
		}, { new("UICorner", { CornerRadius = UDim.new(1, 0) }) })
		local fill = new("Frame", {
			Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
			BackgroundColor3 = currentColors().Accent,
			Parent = track,
		}, { new("UICorner", { CornerRadius = UDim.new(1, 0) }) })

		local dragging = false
		local function setFromAlpha(alpha)
			alpha = math.clamp(alpha, 0, 1)
			local raw = min + (max - min) * alpha
			if rounding <= 0 then
				value = math.floor(raw + 0.5)
			else
				local mult = 10 ^ rounding
				value = math.floor(raw * mult + 0.5) / mult
			end
			Library.Flags[flag] = value
			label.Text = (o.Text or "Slider") .. ": " .. tostring(value)
			fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
			if o.Callback then task.spawn(o.Callback, value) end
		end

		track.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				local rel = (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X
				setFromAlpha(rel)
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				local rel = (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X
				setFromAlpha(rel)
			end
		end)
		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end)

		table.insert(Window._colorObjs, function(c)
			label.TextColor3 = c.Text
			track.BackgroundColor3 = c.Toggle_Off
			fill.BackgroundColor3 = c.Accent
		end)

		local api = {
			Set = function(_, v) setFromAlpha((v - min) / (max - min)) end,
			Get = function() return value end,
		}
		Window.Elements[flag] = api
		return api
	end

	-- --- Button ---
	function Window:AddButton(o)
		o = o or {}
		local row = rowBase(30)
		local btn = new("TextButton", {
			Size = UDim2.new(1, -8, 1, 0),
			Position = UDim2.fromOffset(4, 0),
			BackgroundColor3 = currentColors().Toggle_Off,
			Text = o.Text or "Button",
			TextColor3 = currentColors().Text,
			Font = Enum.Font.GothamMedium,
			TextSize = 13,
			AutoButtonColor = false,
			Parent = row,
		}, { new("UICorner", { CornerRadius = UDim.new(0, 5) }) })

		btn.MouseButton1Click:Connect(function()
			tween(btn, { BackgroundColor3 = currentColors().Accent }, 0.08)
			task.delay(0.1, function()
				tween(btn, { BackgroundColor3 = currentColors().Toggle_Off }, 0.15)
			end)
			if o.Callback then task.spawn(o.Callback) end
		end)

		table.insert(Window._colorObjs, function(c)
			btn.BackgroundColor3 = c.Toggle_Off
			btn.TextColor3 = c.Text
		end)
	end

	-- --- Dropdown ---
	-- opts: {Text, Options={...}, Default, Flag, Callback=function(value) end}
	function Window:AddDropdown(o)
		o = o or {}
		local flag = o.Flag or o.Text
		local options = o.Options or {}
		local selected = o.Default or options[1]
		Library.Flags[flag] = selected

		local row = rowBase(30)
		local label = new("TextLabel", {
			Size = UDim2.new(1, -8, 0, 16),
			Position = UDim2.fromOffset(4, 0),
			BackgroundTransparency = 1,
			Text = o.Text or "Dropdown",
			TextColor3 = currentColors().SubText,
			Font = Enum.Font.Gotham,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		})
		local main = new("TextButton", {
			Size = UDim2.new(1, -8, 0, 26),
			Position = UDim2.fromOffset(4, 16),
			BackgroundColor3 = currentColors().Toggle_Off,
			Text = tostring(selected),
			TextColor3 = currentColors().Text,
			Font = Enum.Font.Gotham,
			TextSize = 12,
			AutoButtonColor = false,
			Parent = row,
		}, { new("UICorner", { CornerRadius = UDim.new(0, 5) }) })

		local listOpen = false
		local listFrame
		local function closeList()
			if listFrame then listFrame:Destroy() listFrame = nil end
			listOpen = false
		end
		main.MouseButton1Click:Connect(function()
			if listOpen then closeList() return end
			listOpen = true
			listFrame = new("Frame", {
				Size = UDim2.new(1, 0, 0, math.min(#options, 5) * 22),
				Position = UDim2.new(0, 0, 1, 2),
				BackgroundColor3 = currentColors().Secondary,
				ZIndex = 5,
				Parent = main,
			}, {
				new("UICorner", { CornerRadius = UDim.new(0, 5) }),
				new("UIListLayout", {}),
			})
			for _, opt in ipairs(options) do
				local optBtn = new("TextButton", {
					Size = UDim2.new(1, 0, 0, 22),
					BackgroundTransparency = 1,
					Text = tostring(opt),
					TextColor3 = currentColors().Text,
					Font = Enum.Font.Gotham,
					TextSize = 12,
					ZIndex = 5,
					Parent = listFrame,
				})
				optBtn.MouseButton1Click:Connect(function()
					selected = opt
					Library.Flags[flag] = opt
					main.Text = tostring(opt)
					if o.Callback then task.spawn(o.Callback, opt) end
					closeList()
				end)
			end
		end)

		row.Size = UDim2.new(1, 0, 0, 46)

		table.insert(Window._colorObjs, function(c)
			label.TextColor3 = c.SubText
			main.BackgroundColor3 = c.Toggle_Off
			main.TextColor3 = c.Text
		end)

		local api = {
			Set = function(_, v) selected = v; Library.Flags[flag] = v; main.Text = tostring(v) end,
			Get = function() return selected end,
		}
		Window.Elements[flag] = api
		return api
	end

	-- --- Label / раздел ---
	function Window:AddLabel(text)
		local row = rowBase(20)
		local lbl = new("TextLabel", {
			Size = UDim2.new(1, -8, 1, 0),
			Position = UDim2.fromOffset(4, 0),
			BackgroundTransparency = 1,
			Text = text or "",
			TextColor3 = currentColors().SubText,
			Font = Enum.Font.GothamBold,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		})
		table.insert(Window._colorObjs, function(c) lbl.TextColor3 = c.SubText end)
	end

	-- регистрируем общий враппер применения темы для всего окна
	table.insert(Library._onThemeChanged, function(c)
		for _, fn in ipairs(Window._colorObjs) do fn(c) end
	end)

	Window.Frame = Frame
	table.insert(Library.Windows, Window)
	return Window
end

-- =========================================================
-- SETTINGS WINDOW (тема + сохранение конфига) — тоже отдельная секция
-- =========================================================
function Library:CreateSettingsWindow(opts)
	opts = opts or {}
	local Window = Library:CreateWindow({
		Title = opts.Title or "Settings",
		Icon = "settings",
		Position = opts.Position or UDim2.fromOffset(320, 40),
		Size = opts.Size or UDim2.fromOffset(240, 220),
	})

	Window:AddLabel("THEME")
	Window:AddDropdown({
		Text = "Theme",
		Options = Library:GetThemeNames(),
		Default = Library.CurrentTheme,
		Callback = function(v) Library:SetTheme(v) end,
	})

	Window:AddLabel("CONFIG")
	local nameHolder = { value = "default" }

	Window:AddButton({
		Text = "Save Config",
		Callback = function()
			local ok, err = pcall(function()
				if not isfolder(Library.ConfigFolder) then makefolder(Library.ConfigFolder) end
				local data = HttpService:JSONEncode(Library.Flags)
				writefile(Library.ConfigFolder .. "/" .. nameHolder.value .. ".json", data)
			end)
			if not ok then warn("Save failed:", err) end
		end,
	})

	Window:AddButton({
		Text = "Load Config",
		Callback = function()
			local ok, err = pcall(function()
				local path = Library.ConfigFolder .. "/" .. nameHolder.value .. ".json"
				if isfile(path) then
					local data = HttpService:JSONDecode(readfile(path))
					for flag, value in pairs(data) do
						Library.Flags[flag] = value
						for _, w in ipairs(Library.Windows) do
							local el = w.Elements[flag]
							if el then el:Set(value) end
						end
					end
				end
			end)
			if not ok then warn("Load failed:", err) end
		end,
	})

	return Window
end

-- =========================================================
-- WATERMARK WINDOW (отдельная секция: FPS/ping + активные бинды)
-- =========================================================
function Library:CreateWatermark(opts)
	opts = opts or {}
	local colors = currentColors()

	local Frame = new("Frame", {
		Name = "Watermark",
		Size = opts.Size or UDim2.fromOffset(190, 26),
		Position = opts.Position or UDim2.fromOffset(8, 8),
		BackgroundColor3 = colors.Background,
		BackgroundTransparency = 0.05,
		BorderSizePixel = 0,
		Parent = ScreenGui,
	}, {
		new("UICorner", { CornerRadius = UDim.new(0, 6) }),
		new("UIStroke", { Color = colors.Stroke, Thickness = 1 }),
		new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 6),
		}),
		new("UIPadding", {
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8),
		}),
	})

	local mainLabel = new("TextLabel", {
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		Text = opts.Text or "modular ui",
		TextColor3 = colors.Accent,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		Parent = Frame,
	})
	local sep1 = new("TextLabel", {
		Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1, Text = "|",
		TextColor3 = colors.SubText, Font = Enum.Font.Gotham, TextSize = 12, Parent = Frame,
	})
	local fpsLabel = new("TextLabel", {
		Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1, Text = "0 fps",
		TextColor3 = colors.Text, Font = Enum.Font.Gotham, TextSize = 12, Parent = Frame,
	})
	local sep2 = new("TextLabel", {
		Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1, Text = "|",
		TextColor3 = colors.SubText, Font = Enum.Font.Gotham, TextSize = 12, Parent = Frame,
	})
	local pingLabel = new("TextLabel", {
		Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1, Text = "0 ms",
		TextColor3 = colors.Text, Font = Enum.Font.Gotham, TextSize = 12, Parent = Frame,
	})

	makeDraggable(Frame, Frame)

	-- FPS счётчик
	local frameCount, lastClock = 0, os.clock()
	RunService.RenderStepped:Connect(function()
		frameCount += 1
		local now = os.clock()
		if now - lastClock >= 1 then
			fpsLabel.Text = string.format("%d fps", frameCount)
			frameCount = 0
			lastClock = now
		end
	end)

	-- Пинг (через Stats)
	task.spawn(function()
		while task.wait(1) do
			local ok, ping = pcall(function()
				return math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue())
			end)
			pingLabel.Text = (ok and ping or 0) .. " ms"
		end
	end)

	table.insert(Library._onThemeChanged, function(c)
		Frame.BackgroundColor3 = c.Background
		mainLabel.TextColor3 = c.Accent
		fpsLabel.TextColor3 = c.Text
		pingLabel.TextColor3 = c.Text
		sep1.TextColor3 = c.SubText
		sep2.TextColor3 = c.SubText
		for _, ch in ipairs(Frame:GetChildren()) do
			if ch:IsA("UIStroke") then ch.Color = c.Stroke end
		end
	end)

	return Frame
end

-- =========================================================
-- BIND LIST WINDOW (отдельная секция: список всех активных бинды)
-- как окно "Keybinds" в Obsidian/Delta
-- =========================================================
function Library:CreateBindListWindow(opts)
	opts = opts or {}
	local Window = Library:CreateWindow({
		Title = opts.Title or "Keybinds",
		Icon = "keyboard",
		Position = opts.Position or UDim2.fromOffset(580, 40),
		Size = opts.Size or UDim2.fromOffset(200, 160),
	})

	local rows = {}

	local function refresh()
		for _, r in pairs(rows) do r:Destroy() end
		rows = {}
		for flag, bind in pairs(Library.Binds) do
			if bind.Key then
				Window:AddLabel(bind.Name .. "  [" .. (bind.Display or tostring(bind.Key)) .. "]")
			end
		end
	end

	-- обновляем список раз в секунду (простая реализация без лишней сложности)
	task.spawn(function()
		while task.wait(1) do
			pcall(refresh)
		end
	end)

	return Window
end

return Library
