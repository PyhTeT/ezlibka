Library.Flags = {}          -- [FlagName] = value              (для конфигов)
Library.Binds = {}          -- [FlagName] = {Key=..., Element=...}  (для бинд-листа)
Library.CurrentTheme = "Obsidian"
Library.Windows = {}        -- список созданных секционных окон
Library.ConfigFolder = "ModularUI/configs"
Library._onThemeChanged = {}

local function currentColors()
	return Themes[Library.CurrentTheme]
end

function Library:SetTheme(themeName)
	if not Themes[themeName] then return end
	Library.CurrentTheme = themeName
	for _, fn in ipairs(Library._onThemeChanged) do
		fn(Themes[themeName])
	end
end

function Library:GetThemeNames()
	local names = {}
	for name in pairs(Themes) do table.insert(names, name) end
	table.sort(names)
	return names
end

